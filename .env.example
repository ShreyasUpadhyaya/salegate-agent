# Copy this file to .env and fill in your own key. .env is gitignored and never committed.

# A Gemini API key. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where a running Salegate API is reachable. Default assumes it's running
# locally per the salegate repo's own README ("uv run uvicorn app.main:app --port 8000").
SALEGATE_API_BASE=http://127.0.0.1:8000
